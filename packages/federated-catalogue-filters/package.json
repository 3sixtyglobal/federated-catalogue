{
	"name": "@twin.org/federated-catalogue-filters",
	"version": "0.0.3-next.10",
	"description": "Federated Catalogue filter implementations",
	"repository": {
		"type": "git",
		"url": "https://github.com/twinfoundation/federated-catalogue.git",
		"directory": "packages/federated-catalogue-filters"
	},
	"author": "cornel.filip@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/api-models": "next",
		"@twin.org/core": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/federated-catalogue-models": "0.0.3-next.10",
		"@twin.org/federated-catalogue-service": "0.0.3-next.10",
		"@twin.org/logging-models": "next",
		"@twin.org/standards-dataspace-protocol": "next",
		"@twin.org/standards-w3c-dcat": "next",
		"@twin.org/web": "next"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/modules": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/standards-ld-contexts": "next",
		"@types/node": "25.3.3",
		"@vitest/coverage-v8": "4.0.18",
		"copyfiles": "2.4.1",
		"rimraf": "6.1.3",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.17",
		"typedoc-plugin-markdown": "4.10.0",
		"typescript": "5.9.3",
		"vitest": "4.0.18"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"federated-catalogue",
		"service",
		"microservice",
		"business-logic"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/federated-catalogue/issues"
	},
	"homepage": "https://twindev.org"
}
