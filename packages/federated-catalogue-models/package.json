{
	"name": "@twin.org/federated-catalogue-models",
	"version": "0.10.0",
	"description": "Models which define the structure of the Federated Catalogue Service",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-federated-catalogue.git",
		"directory": "packages/federated-catalogue-models"
	},
	"author": "cornel.filip@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage src/schemas",
		"build:compile": "tspc",
		"build": "npm run build:compile",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/core": "^0.10.0",
		"@twin.org/data-core": "^0.10.0",
		"@twin.org/data-json-ld": "^0.10.0",
		"@twin.org/entity": "^0.10.0",
		"@twin.org/nameof": "^0.10.0",
		"@twin.org/standards-dataspace-protocol": "^0.10.0",
		"@twin.org/standards-w3c-dcat": "^0.10.0",
		"@twin.org/telemetry-models": "^0.10.0",
		"@twin.org/trust-models": "^0.10.0",
		"@twin.org/web": "^0.10.0"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "^0.10.0",
		"@twin.org/nameof-vitest-plugin": "^0.10.0",
		"@twin.org/validate-locales": "^0.10.0",
		"@vitest/coverage-v8": "4.1.10",
		"copyfiles": "2.4.1",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.12.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"federated-catalogue",
		"models",
		"types",
		"schemas"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-federated-catalogue/issues"
	},
	"homepage": "https://twindev.org"
}
