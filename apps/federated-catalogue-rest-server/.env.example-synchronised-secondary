########### Web Server Options ###########

FEDERATED_CATALOGUE_PORT=3021
FEDERATED_CATALOGUE_HOST="0.0.0.0"
FEDERATED_CATALOGUE_CORS_ORIGINS=*
FEDERATED_CATALOGUE_HTTP_METHODS=
FEDERATED_CATALOGUE_HTTP_ALLOWED_HEADERS=
FEDERATED_CATALOGUE_HTTP_EXPOSED_HEADERS=
FEDERATED_CATALOGUE_MIME_TYPE_PROCESSORS=jwt

########### Global Options ###########

## Must be false for sync to work
FEDERATED_CATALOGUE_DISABLE_NODE_IDENTITY=false

FEDERATED_CATALOGUE_DEBUG=true

########### Identity (Different from Node A) ###########

FEDERATED_CATALOGUE_IDENTITY_CONNECTOR="entity-storage"

## Different private key/mnemonic from the trusted node
FEDERATED_CATALOGUE_IDENTITY_PRIVATE_KEY="different-private-key-for-node-b"

########### Entity Storage with Synchronised Wrapper ###########

FEDERATED_CATALOGUE_ENTITY_STORAGE_CONNECTOR_TYPE="file,synchronised"
FEDERATED_CATALOGUE_ENTITY_STORAGE_CONNECTOR_DEFAULT="synchronised"

## Different storage directory from Node A
FEDERATED_CATALOGUE_STORAGE_FILE_ROOT="../../.local-data/fed-catalogue-node-b/"

########### Synchronised Storage Client (Non-Trusted Node) ###########

## This node does NOT run sync service; it reads from the trusted node's REST endpoint
FEDERATED_CATALOGUE_SYNCHRONISED_STORAGE_ENABLED=false

## Point to the trusted node's synchronised storage REST endpoint
FEDERATED_CATALOGUE_TRUSTED_SYNCHRONISED_STORAGE_COMPONENT_TYPE="rest-client"
FEDERATED_CATALOGUE_TRUSTED_SYNCHRONISED_STORAGE_ENDPOINT="http://localhost:3020/synchronised-storage"

########### Verifiable Storage (Reads Sync Pointers) ###########

FEDERATED_CATALOGUE_VERIFIABLE_STORAGE_CONNECTOR="iota-rebased"

FEDERATED_CATALOGUE_IOTA_NODE_ENDPOINT="https://api.testnet.iotaledger.net"
FEDERATED_CATALOGUE_IOTA_NETWORK="testnet"

########### Blob Storage (Reads Changesets) ###########

FEDERATED_CATALOGUE_BLOB_STORAGE_CONNECTOR_TYPE="file"
FEDERATED_CATALOGUE_BLOB_STORAGE_CONNECTOR_PUBLIC="file"

FEDERATED_CATALOGUE_STORAGE_BLOB_ROOT="../../.local-data/fed-catalogue-node-b/blobs/"

FEDERATED_CATALOGUE_BLOB_STORAGE_ENCRYPTION_KEY_ID="sync-blob-encryption"
FEDERATED_CATALOGUE_SYNCHRONISED_STORAGE_BLOB_STORAGE_ENCRYPTION_KEY_ID="sync-blob-encryption"

########### Vault ###########

FEDERATED_CATALOGUE_VAULT_CONNECTOR="entity-storage"
FEDERATED_CATALOGUE_VAULT_ENCRYPTION_KEY_ID="vault-encryption"

## Different vault seed from Node A
FEDERATED_CATALOGUE_VAULT_SEED="different-vault-seed-for-node-b-min-32-chars"

########### Event Bus ###########

FEDERATED_CATALOGUE_EVENT_BUS_CONNECTOR="local"

########### Task Scheduler ###########

FEDERATED_CATALOGUE_TASK_SCHEDULER_ENABLED=true

########### Logging ###########

FEDERATED_CATALOGUE_LOGGING_CONNECTOR="console"

########### Federated Catalogue ###########

FEDERATED_CATALOGUE_FEDERATED_CATALOGUE_ENABLED=true
FEDERATED_CATALOGUE_FEDERATED_CATALOGUE_FILTERS="filter-by-example"

########### Identity Resolution ###########

FEDERATED_CATALOGUE_IDENTITY_RESOLVER_CONNECTOR="universal"
FEDERATED_CATALOGUE_UNIVERSAL_RESOLVER_ENDPOINT="https://uni-resolver.tlip.io"
# 24 hours
FEDERATED_CATALOGUE_SUB_RESOURCE_CACHE_TTL_MS=86400000
