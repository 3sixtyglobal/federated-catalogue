	"components": {
		"schemas": {
			"CatalogRequestResponse": {
				"anyOf": [
					{
						"$ref": "https://schema.twindev.org/dataspace-protocol/DataspaceProtocolCatalog"
					},
					{
						"$ref": "https://schema.twindev.org/dataspace-protocol/DataspaceProtocolCatalogError"
					}
				],
				"description": "The response payload containing the DS Protocol compliant catalog with participantId, or a CatalogError if no datasets are found (404). Per DS Protocol: Single participant returns flat catalog, multiple participants return nested catalogs."
			},
			"Error": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"description": "The name for the error."
					},
					"message": {
						"type": "string",
						"description": "The message for the error."
					},
					"source": {
						"type": "string",
						"description": "The source of the error."
					},
					"properties": {
						"type": "object",
						"additionalProperties": {},
						"description": "Any additional information for the error."
					},
					"stack": {
						"type": "string",
						"description": "The stack trace for the error."
					},
					"cause": {
						"$ref": "#/components/schemas/Error"
					}
				},
				"required": [
					"name",
					"message"
				],
				"description": "Model to describe serialized error."
			},
			"GetDatasetResponse": {
				"anyOf": [
					{
						"$ref": "https://schema.twindev.org/dcat/DcatDataset"
					},
					{
						"$ref": "https://schema.twindev.org/dataspace-protocol/DataspaceProtocolCatalogError"
					}
				],
				"description": "The response payload containing the dataset or error."
			},
			"HealthComponentInfo": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"description": "The name of the component."
					},
					"status": {
						"$ref": "#/components/schemas/HealthStatus"
					},
					"details": {
						"type": "string",
						"description": "The details for the status."
					}
				},
				"required": [
					"name",
					"status"
				],
				"description": "The health component information."
			},
			"HealthInfo": {
				"type": "object",
				"properties": {
					"status": {
						"$ref": "#/components/schemas/HealthStatus"
					},
					"components": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/HealthComponentInfo"
						},
						"description": "The status of the components."
					}
				},
				"required": [
					"status"
				],
