########### Web Server Options ###########

FEDERATED_CATALOGUE_PORT=3020
FEDERATED_CATALOGUE_HOST="0.0.0.0"
FEDERATED_CATALOGUE_CORS_ORIGINS=*
FEDERATED_CATALOGUE_HTTP_METHODS=
FEDERATED_CATALOGUE_HTTP_ALLOWED_HEADERS=
FEDERATED_CATALOGUE_HTTP_EXPOSED_HEADERS=
FEDERATED_CATALOGUE_MIME_TYPE_PROCESSORS=jwt

########### Global Options ###########

## Must be false for sync to work (sync connector requires node identity)
FEDERATED_CATALOGUE_DISABLE_NODE_IDENTITY=false

## Set DEBUG to true to enable additional information in the logs
FEDERATED_CATALOGUE_DEBUG=true

########### Identity (Required for Sync) ###########

## Node identity (DID) - required when DISABLE_NODE_IDENTITY=false
FEDERATED_CATALOGUE_IDENTITY_CONNECTOR="entity-storage"

## Mnemonic or private key for the node identity
FEDERATED_CATALOGUE_IDENTITY_PRIVATE_KEY="your-private-key-or-mnemonic-here"

########### Entity Storage with Synchronised Wrapper ###########

## Order matters: base storage first, then synchronised
FEDERATED_CATALOGUE_ENTITY_STORAGE_CONNECTOR_TYPE="file,synchronised"
FEDERATED_CATALOGUE_ENTITY_STORAGE_CONNECTOR_DEFAULT="synchronised"

## Storage for files will use this folder as its root
## In Docker, map this to a mounted volume to be persistent
FEDERATED_CATALOGUE_STORAGE_FILE_ROOT="../../.local-data/fed-catalogue-node-a/"

########### Synchronised Storage Service (Trusted Node) ###########

## Enable synchronised storage service (this node can write to verifiable storage)
FEDERATED_CATALOGUE_SYNCHRONISED_STORAGE_ENABLED=true

## Verifiable storage key ID for sync pointer (e.g., IOTA testnet)
FEDERATED_CATALOGUE_SYNCHRONISED_STORAGE_VERIFIABLE_STORAGE_KEY_ID="testnet"

## Sync intervals (milliseconds)
FEDERATED_CATALOGUE_SYNCHRONISED_STORAGE_UPDATE_INTERVAL_MS=30000
FEDERATED_CATALOGUE_SYNCHRONISED_STORAGE_CONSOLIDATE_INTERVAL_MS=300000

## Batch size for sync operations
FEDERATED_CATALOGUE_SYNCHRONISED_STORAGE_BATCH_SIZE=100

########### Verifiable Storage (Required for Sync Pointers) ###########

FEDERATED_CATALOGUE_VERIFIABLE_STORAGE_CONNECTOR="iota-rebased"

## IOTA configuration for sync pointers
FEDERATED_CATALOGUE_IOTA_NODE_ENDPOINT="https://api.testnet.iotaledger.net"
FEDERATED_CATALOGUE_IOTA_NETWORK="testnet"

########### Blob Storage (Required for Sync Changesets) ###########

FEDERATED_CATALOGUE_BLOB_STORAGE_CONNECTOR_TYPE="file"
FEDERATED_CATALOGUE_BLOB_STORAGE_CONNECTOR_PUBLIC="file"

## Blob storage root directory
FEDERATED_CATALOGUE_STORAGE_BLOB_ROOT="../../.local-data/fed-catalogue-node-a/blobs/"

## Blob storage encryption key ID (for encrypted changesets)
FEDERATED_CATALOGUE_BLOB_STORAGE_ENCRYPTION_KEY_ID="sync-blob-encryption"
FEDERATED_CATALOGUE_SYNCHRONISED_STORAGE_BLOB_STORAGE_ENCRYPTION_KEY_ID="sync-blob-encryption"

########### Vault (Required for Keys) ###########

FEDERATED_CATALOGUE_VAULT_CONNECTOR="entity-storage"

## Vault encryption key ID
FEDERATED_CATALOGUE_VAULT_ENCRYPTION_KEY_ID="vault-encryption"

## Vault seed (for key derivation)
FEDERATED_CATALOGUE_VAULT_SEED="your-vault-seed-here-min-32-chars-long-secret"

########### Event Bus (Required for Sync Communication) ###########

FEDERATED_CATALOGUE_EVENT_BUS_CONNECTOR="local"

########### Task Scheduler (Required for Sync Intervals) ###########

FEDERATED_CATALOGUE_TASK_SCHEDULER_ENABLED=true

########### Logging ###########

FEDERATED_CATALOGUE_LOGGING_CONNECTOR="console"

########### Federated Catalogue Filters ###########

FEDERATED_CATALOGUE_FEDERATED_CATALOGUE_ENABLED=true
FEDERATED_CATALOGUE_FEDERATED_CATALOGUE_FILTERS="filter-by-example"

########### Identity Resolution (for DS Protocol) ###########

FEDERATED_CATALOGUE_IDENTITY_RESOLVER_CONNECTOR="universal"
FEDERATED_CATALOGUE_UNIVERSAL_RESOLVER_ENDPOINT="https://uni-resolver.tlip.io"
# 24 hours
FEDERATED_CATALOGUE_SUB_RESOURCE_CACHE_TTL_MS=86400000

########### Clearing House (optional) ###########

# FEDERATED_CATALOGUE_CLEARING_HOUSE_APPROVER_LIST='["did:iota:testnet:0x..."]'
