{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"package.json",
		"vitest.config.*",
		"tsconfig.json",
		"tsconfig.eslint.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"changelog.md"
	],
	"words": [
		"abbrev",
		"ABNF",
		"autorelease",
		"bech",
		"buildx",
		"Dataspace",
		"dcat",
		"Dcat",
		"dcmi",
		"dcterms",
		"dspace",
		"EORI",
		"fedcat",
		"Foaf",
		"GLEIF",
		"hotfixes",
		"Jsonld",
		"nameof",
		"odrl",
		"openapi",
		"prov",
		"Stiftung",
		"twindev",
		"twinfoundation",
		"Unrevoke",
		"VATID"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```(?:typescript|ts)[\\s\\S]*?```$/gm",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm",
		"/tst1.*/"
	]
}
